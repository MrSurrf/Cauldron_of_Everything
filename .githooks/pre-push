#!/usr/bin/env sh

echo ""
echo "=== Проверка готовности frontend к push ==="

cd frontend || {
  echo "" >&2
  echo "==============================================" >&2
  echo "ОШИБКА: папка frontend не найдена." >&2
  echo "Убедись, что git push запускается из корня репозитория." >&2
  echo "==============================================" >&2
  exit 1
}

if [ ! -f "package.json" ] || [ ! -f "package-lock.json" ]; then
  echo "" >&2
  echo "==============================================" >&2
  echo "ОШИБКА: не найден package.json или package-lock.json." >&2
  echo "Что-то пошло не так с файлами проекта." >&2
  echo "==============================================" >&2
  exit 1
fi

if [ ! -d "node_modules" ]; then
  echo "" >&2
  echo "==============================================" >&2
  echo "ОШИБКА: папка node_modules не найдена." >&2
  echo "" >&2
  echo "Что сделать:" >&2
  echo "1. Открой терминал в папке frontend" >&2
  echo "2. Выполни: npm install" >&2
  echo "3. Дождись окончания установки" >&2
  echo "4. Повтори git push" >&2
  echo "==============================================" >&2
  exit 1
fi

if [ "package.json" -nt "node_modules/.package-lock.json" ]; then
  echo "" >&2
  echo "==============================================" >&2
  echo "ОШИБКА: зависимости устарели." >&2
  echo "package.json изменялся позже, чем выполнялась npm install." >&2
  echo "" >&2
  echo "Что сделать:" >&2
  echo "1. Выполни в папке frontend: npm install" >&2
  echo "2. Если package-lock.json изменился — добавь его в коммит" >&2
  echo "3. Повтори git push" >&2
  echo "==============================================" >&2
  exit 1
fi

echo ""
echo "=== Сборка проекта ==="

if ! npm run build; then
  echo "" >&2
  echo "==============================================" >&2
  echo "ОШИБКА: npm run build завершился с ошибкой." >&2
  echo "Push отменён." >&2
  echo "" >&2
  echo "Что делать:" >&2
  echo "1. В терминале frontend запусти: npm run build" >&2
  echo "2. Внимательно прочти красные сообщения об ошибках" >&2
  echo "3. Исправь указанные файлы и сохрани" >&2
  echo "4. Снова запусти npm run build — должен пройти без ошибок" >&2
  echo "5. Закоммить исправления и повтори git push" >&2
  echo "" >&2
  echo "Самые частые причины:" >&2
  echo "- ошибка TypeScript: неверный тип, отсутствует импорт, опечатка" >&2
  echo "- отсутствует файл, на который есть import" >&2
  echo "- неправильный путь до картинки или другого ресурса" >&2
  echo "- устаревшие или повреждённые node_modules (помогает npm install)" >&2
  echo "==============================================" >&2
  exit 1
fi

echo ""
echo "=== Всё успешно ==="
echo "Сборка прошла без ошибок. Push разрешён."
exit 0
