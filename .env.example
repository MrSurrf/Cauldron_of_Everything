# Django
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=False
ALLOWED_HOSTS=your-backend-domain.com,www.your-backend-domain.com

# PostgreSQL (в Dokploy эта строка подключения будет в сервисе базы данных)
DATABASE_URL=postgres://user:password@host:5432/dbname

# CORS — публичный адрес фронтенда
CORS_ALLOWED_ORIGINS=https://your-frontend-domain.com

# Vite / React
VITE_API_BASE_URL=https://your-backend-domain.com

# Telegram notifications (optional)
TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
TELEGRAM_CHAT_ID=123456789

# Email notifications (SMTP)
EMAIL_HOST=smtp.yandex.ru
EMAIL_PORT=465
EMAIL_HOST_USER=your-email@yandex.ru
EMAIL_HOST_PASSWORD=your-app-password
EMAIL_USE_TLS=False
EMAIL_USE_SSL=True
DEFAULT_FROM_EMAIL=your-email@yandex.ru
NOTIFICATION_EMAIL=your-email@yandex.ru,another-email@example.com
